#include <POP32.h> #define NUM_SENSOR 9 int senserPort[] = { 0, 1, 2, 3, 4, 5, 6, 7, 8 }; // 🎯 Calibrate // int MinS[9] = { 738, 392, 542, 889, 465, 866, 658, 586, 758 }; // int MaxS[9] = { 3900, 2666, 3881, 3918, 3856, 3903, 3818, 3897, 3919 }; int MinS[9] = { 613, 564, 473, 702, 498, 424, 545, 509, 560 }; int MaxS[9] = { 3886, 3841, 3858, 3885, 3827, 3859, 3839, 3876, 3903 }; int curveMemory = 0; int dirMemory = 0; int lastGoodErr = 0; int mode = 0; int sVal[9]; int pos = 4000; int err = 0, L_err = 0; bool found = false; int last_L = 0; int last_R = 0; // ================= MOVE (soft motor control) ================= void move(int L, int R) { int curvePower = abs(err); int max_step; if (curvePower < 300) max_step = 10; // ทางตรงลื่น else if (curvePower < 1000) max_step = 6; else max_step = 4; if (L > last_L + max_step) L = last_L + max_step; else if (L < last_L - max_step) L = last_L - max_step; if (R > last_R + max_step) R = last_R + max_step; else if (R < last_R - max_step) R = last_R - max_step; motor(1, constrain(L, -100, 100)); motor(2, constrain(R, -100, 100)); last_L = L; last_R = R; } // ================= READ SENSOR ================= void read() { long sum = 0, wSum = 0; found = false; for (int i = 0; i < 9; i++) { int v = map(analog(senserPort[i]), MaxS[i], MinS[i], 0, 1000); v = constrain(v, 0, 1000); sVal[i] = v; if (v > 500) { found = true; wSum += (long)v * (i * 1000); sum += v; } } if (found) { int newPos = wSum / sum; // 🔥 smoothing กันส่าย pos = (pos * 3 + newPos) / 4; } } // ================= FOLLOW LINE ================= void follow(int sp) { read(); // 🔴 หลุดเส้น if (!found) { move(-20, -20); return; } err = pos - 4000; // 🔥 deadzone ลดส่ายทางตรง if (abs(err) < 30) err = 0; int curve = abs(err); float Kp, Kd; // ================= PID tuning ================= if (curve < 400) { Kp = 0.018; Kd = 0.9; // ทางตรงนิ่ง } else if (curve < 1200) { Kp = 0.025; Kd = 1.2; } else { Kp = 0.038; Kd = 1.6; // โค้งคม } int pid = (Kp * err) + (Kd * (err - L_err)); L_err = err; int left = sp + pid; int right = sp - pid; // 🔥 curve brake (ช่วยโค้งไม่เหวี่ยง) if (curve > 1200) { left *= 0.75; right *= 0.75; } move(left, right); } // ================= RUN ================= void run(int sp, int time, int m) { mode = m; uint32_t T = millis(); int spNow = sp; float pidNow = 0; int curveMemory = 0; int dirMemory = 0; int lastGoodErr = 0; int curveLock = 0; while (millis() - T < time) { read(); // ================= CORE SENSOR ================= int err = pos - 4000; int curve = abs(err); // =================🔥 FIX: โค้งขวาหลุด ================= if (curve > 300) { dirMemory = (err > 0) ? 1 : -1; } if (curve > 300 && curve < 1200) { err = lastGoodErr * 0.6 + err * 0.4; } if (curve > 300) { lastGoodErr = err; } // =================🔥 CURVE LOCK ================= if (curve > 500) { curveMemory = curve; curveLock = 8; dirMemory = (err > 0) ? 1 : -1; } if (curveLock > 0) curveLock--; else curveMemory *= 0.90; int activeCurve = max(curve, curveMemory); // ================= SPEED ================= int targetSp; if (activeCurve > 1200) targetSp = sp * 0.45; else if (activeCurve > 700) targetSp = sp * 0.55; else if (activeCurve > 300) targetSp = sp * 0.75; else targetSp = sp; spNow = (spNow * 3 + targetSp) / 4; // ================= LOST LINE ================= bool lostLine = true; for (int i = 0; i < 9; i++) { if (sVal[i] > 350) lostLine = false; } if (lostLine) { err = lastGoodErr; } // ================= DEADZONE ================= if (abs(err) < 25) err = 0; // ================= PID ================= float Kp, Kd; if (activeCurve < 400) { Kp = 0.018; Kd = 0.9; } else if (activeCurve < 1200) { Kp = 0.030; Kd = 1.2; } else { Kp = 0.040; Kd = 1.5; } float pidTarget = (Kp * err) + (Kd * (err - L_err)); L_err = err; pidNow = (pidNow * 2 + pidTarget) / 3; pidNow = constrain(pidNow, -85, 85); int left = spNow + pidNow; int right = spNow - pidNow; // ================= BRAKE ================= if (activeCurve > 1000) { left *= 0.65; right *= 0.65; } move(left, right); } mode = 0; } // ================= TURN ================= void turnLeft(int sp) { motor(1, -sp); motor(2, sp); delay(180); while (true) { read(); if (sVal[4] > 600) break; } last_L = -sp; last_R = sp; } void turnRight(int sp) { motor(1, sp); motor(2, -sp); delay(180); while (true) { read(); if (sVal[4] > 600) break; } last_L = sp; last_R = -sp; } // ================= CHECK LEFT ================= void checkL(int sp) { while (true) { follow(sp); if (sVal[0] > 700 && sVal[1] > 700 && sVal[2] > 700 && sVal[3] > 700 && sVal[4] > 700) { break; } } motor(1, sp); motor(2, sp); delay(50); turnLeft(sp - 15); } // ================= CHECK RIGHT ================= void checkR(int sp) { while (true) { follow(sp); if (sVal[8] > 700 && sVal[7] > 700 && sVal[6] > 700 && sVal[5] > 700 && sVal[4] > 700) { break; } } motor(1, sp); motor(2, sp); delay(50); turnRight(sp - 15); } void checkCross(int sp) { while (true) { follow(sp); // วิ่งตามเส้นไปเรื่อยๆ // เช็คว่าเซนเซอร์ซ้ายสุด (0), ขวาสุด (8) และตรงกลาง (4) เจอเส้นดำพร้อมกัน if (sVal[0] > 700 && sVal[8] > 700 && sVal[4] > 700) { break; } } // พอเจอแยกกากบาท สั่งให้วิ่งตรงทะลุแยกไปนิดนึง // (เพื่อป้องกันไม่ให้ลูปต่อไปกลับมาอ่านเจอเส้นตัดขวางเส้นเดิมซ้ำ) motor(1, sp); motor(2, sp); last_L = sp; last_R = sp; delay(150); } void autoRun(int minSp, int maxSp, int totalTime) { uint32_t T = millis(); while (millis() - T < totalTime) { int t = millis() - T; int sp; if (t < totalTime / 2) { sp = map(t, 0, totalTime / 2, minSp, maxSp); } else { sp = map(t, totalTime / 2, totalTime, maxSp, minSp); } follow(sp); } } void resetState() { L_err = 0; pos = 4000; last_L = 0; last_R = 0; curveMemory = 0; dirMemory = 0; } void prepareRun() { for (int i = 0; i < 10; i++) { read(); delay(5); } } // ================= SETUP ================= void setup() { waitSW_OK(); beep(); delay(500); } // ================= LOOP ================= void loop() { // autoRun(40, 90, 760); // delay(30); // prepareRun(); // resetState(); // run(50, 840, 0); // autoRun(40, 90, 240); // delay(30); // prepareRun(); // resetState(); // run(50, 1500, 0); // autoRun(40, 90, 400); // delay(30); // prepareRun(); // resetState(); // run(50, 840, 0); autoRun(40, 85, 260); delay(30); prepareRun(); resetState(); run(45, 900, 0); autoRun(40, 85, 240); delay(30); prepareRun(); resetState(); run(45, 840, 0); autoRun(40, 85, 260); delay(30); prepareRun(); resetState(); run(50, 840, 0); autoRun(40, 85, 300); delay(30); prepareRun(); resetState(); run(50, 2400, 0); run(45, 2000, 0); autoRun(40, 85, 240); delay(30); prepareRun(); resetState(); run(50, 800, 0); autoRun(40, 85, 200); delay(30); prepareRun(); resetState(); checkL(45); checkCross(45); checkCross(45); checkCross(45); checkR(50); checkCross(45); checkL(45); run(50, 3000, 0); autoRun(40, 85, 100); delay(30); prepareRun(); resetState(); ////////////////////////////////หลัง // autoRun(40, 80, 280); // delay(30); // prepareRun(); // resetState(); // run(60, 600, 0); // autoRun(40, 90, 1070); // delay(30); // prepareRun(); // resetState(); // run(60, 600, 0); // autoRun(40, 90, 1100); // run(60, 2200, 0); AO(); while (true) ; }
